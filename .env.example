# Optional Docker Compose host port. API defaults to port 8000 for local Vite.
WEB_PORT=5173
# Local API path. Docker Compose sets its own persistent volume path.
DATABASE_PATH=data/aibuddy.sqlite3
# Set all three LLM variables for the optional OpenAI-compatible mode.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
